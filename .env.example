# Credentials for Yandex Object Storage. Keep real values only in .env or
# the shell environment; never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # only when temporary credentials are issued
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=s3-ds-source

# MLflow tracking server issued in the week 3 lesson.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
